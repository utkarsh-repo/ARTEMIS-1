{
  "base_url": "https://staging.example.test",
  "allowed_hosts": [
    "staging.example.test"
  ],
  "allowed_path_prefixes": [
    "/",
    "/api/"
  ],
  "https_only": true,
  "allow_private_networks": false,
  "allowed_methods": [
    "GET",
    "HEAD",
    "OPTIONS"
  ],
  "allow_state_changing_tests": false,
  "max_requests": 80,
  "requests_per_second": 1.0,
  "request_timeout_seconds": 12,
  "max_response_bytes": 250000,
  "max_model_observation_chars": 3000,
  "user_agent": "ARTEMIS/2.2.0",
  "baseline_paths": [
    "/",
    "/robots.txt",
    "/.well-known/security.txt"
  ],
  "probe_openapi_gets": false,
  "protected_paths": [],
  "auth_env": "LAB_BEARER_TOKEN",
  "security_headers": [
    "content-security-policy",
    "strict-transport-security",
    "x-content-type-options",
    "x-frame-options",
    "referrer-policy",
    "permissions-policy"
  ],
  "stop_on_5xx": 3,
  "max_planner_iterations": 30,
  "max_intents_per_iteration": 3,
  "enabled_tests": [
    "security_headers",
    "cookie_flags",
    "technology_disclosure",
    "cache_policy",
    "content_type",
    "cors_preflight",
    "http_method_surface",
    "error_surface",
    "anonymous_auth_boundary",
    "openapi_inventory",
    "scenario_suite",
    "workflow_invariants"
  ],
  "allowed_ports": [
    443
  ]
}
